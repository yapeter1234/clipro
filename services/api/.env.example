# Supabase project URL. API verifies asymmetric ES256/RS256 signing keys.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Server-side Postgres connection string. Never expose this to browser code.
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Cloudflare R2 S3 API credentials scoped to the Clipro bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

UPLOAD_MAX_FILE_SIZE_BYTES=21474836480
UPLOAD_PART_URL_TTL_SECONDS=900
UPLOAD_SESSION_TTL_HOURS=24
