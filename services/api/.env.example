# Shared HMAC secret: must exactly match CLIPRO_API_TOKEN_SECRET in the Next.js server environment.
# Generate with: openssl rand -hex 32
CLIPRO_API_TOKEN_SECRET=REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_SECRET
CLIPRO_API_TOKEN_ISSUER=clipro-web
CLIPRO_API_TOKEN_AUDIENCE=clipro-api

# Transitional durable metadata database. Supabase Auth is not used by Clipro.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_POOLER_HOST:5432/postgres
DATABASE_SSL=true

# Cloudflare R2 S3 API credentials scoped to the private Clipro bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

CLIPRO_WEB_ORIGINS=http://localhost:3000
CLIPRO_MODAL_APP_NAME=clipro-workers
CLIPRO_MODAL_PROBE_FUNCTION=probe_asset
CLIPRO_MODAL_ANALYSIS_FUNCTION=analyze_asset
CLIPRO_MODAL_DISPATCH_ENABLED=false

UPLOAD_MAX_FILE_SIZE_BYTES=21474836480
UPLOAD_PART_URL_TTL_SECONDS=900
UPLOAD_SESSION_TTL_HOURS=24
