# Supabase project URL. API verifies asymmetric ES256/RS256 signing keys.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Server-side database connection. Get the Session pooler URI from Supabase > Connect.
# Replace its password placeholder with your actual database password.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_POOLER_HOST:5432/postgres
DATABASE_SSL=true

# Cloudflare R2 S3 API credentials scoped to the Clipro bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

CLIPRO_WEB_ORIGINS=http://localhost:3000
CLIPRO_MODAL_APP_NAME=clipro-workers
CLIPRO_MODAL_PROBE_FUNCTION=probe_asset
CLIPRO_MODAL_DISPATCH_ENABLED=false

UPLOAD_MAX_FILE_SIZE_BYTES=21474836480
UPLOAD_PART_URL_TTL_SECONDS=900
UPLOAD_SESSION_TTL_HOURS=24
