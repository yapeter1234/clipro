# Private operator password. Use a long, unique random password (20+ characters).
CLIPRO_OPERATOR_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_OPERATOR_PASSWORD

# Session signing secret used only by Next.js. Generate: openssl rand -hex 32
CLIPRO_SESSION_SECRET=REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_SECRET

# API-token signing secret. Generate once and use the SAME value in Vercel and the Modal API Secret.
CLIPRO_API_TOKEN_SECRET=REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_SECRET

# Server-only Modal FastAPI base URL. Do not prefix with NEXT_PUBLIC_.
CLIPRO_API_URL=https://YOUR-CLIPRO-API.modal.run
